# Copy to .env.local (git-ignored) or set in CI. Both are optional and public
# (they end up in the built HTML/JS); leave empty to disable.

# Cloudflare Web Analytics site token (cookieless beacon, loaded on every page).
VITE_CF_WEB_ANALYTICS_TOKEN=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Loaded only after the
# visitor accepts analytics in the consent banner. Unset = no GA, no banner.
VITE_GA_MEASUREMENT_ID=
